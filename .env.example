# Copie este arquivo para .env e ajuste o que for preciso.
# cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Banco de dados ---
# Já aponta para o serviço "db" do docker-compose. Só muda se rodar fora do Docker.
DATABASE_URL=postgres://nexus:nexus@db:5432/nexus

# --- Sentry (opcional; sem isso o app roda normalmente sem monitoramento) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- E-mail transacional via Resend (opcional; sem chave, e-mails vão pro console) ---
# Configurado a partir da etapa "notificações por e-mail" da Fase 1.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Armazenamento de anexos (Cloudflare R2, compatível com S3) ---
# Configurado a partir da etapa "anexos" da Fase 1. Sem isso, usa disco local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
